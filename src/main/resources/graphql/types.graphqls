type Species {
    id: ID!
    scientificName: String!
    commonName: String
    family: String
    genus: String
    distributionNotes: String
    description: String
    status: Status!
    imageUrl: String
    coordinates: [Coordinate!]!
}

type Coordinate {
    id: ID!
    latitude: Float!
    longitude: Float!
    species: Species!
}